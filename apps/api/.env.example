# Runtime
NODE_ENV="development"
PORT="3001"

# Database
DATABASE_URL=""

# Authentication
JWT_SECRET=""
EMAIL_VERIFICATION_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Server-to-server authentication (must match the web app)
INTERNAL_API_SECRET=""

# Password recovery
PASSWORD_RESET_URL="http://localhost:3000/reset-password"

# Email delivery
MAIL_PROVIDER="smtp"
MAIL_FROM="Ludora <no-reply@ludora.test>"

# SMTP delivery (used when MAIL_PROVIDER is smtp)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"

# Resend delivery (used when MAIL_PROVIDER is resend)
RESEND_API_KEY=""
